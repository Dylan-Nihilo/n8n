# ==========================================
# MBTI茶饮营销自动化配置 v2.0
# ==========================================

# ========== AI服务配置 (Anthropic) ==========
AI_API_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
AI_MODEL=claude-3-5-sonnet-20241022

# 如果使用第三方API（如OpenRouter、Cloudflare等）
# AI_API_BASE_URL=https://openrouter.ai/api
# AI_API_BASE_URL=https://gateway.ai.cloudflare.com

# ========== Notion配置 ==========
NOTION_API_TOKEN=secret_your-notion-integration-token-here

# 数据库ID（使用data_source_id，不是database_id）
NOTION_HOTSPOT_DB_ID=ae70a049-13dc-43fa-a626-c4967dc693ce
NOTION_MATERIAL_DB_ID=2d87fa67-a9af-8173-8337-000b5069249b
NOTION_PRODUCT_DB_ID=2d87fa67-a9af-81b2-bba9-000b8b5a9835
NOTION_CONTENT_DB_ID=2d87fa67-a9af-81bc-a3b4-000be6f79508
NOTION_PUBLISH_DB_ID=86a9eaf4-8507-4d2d-b2b7-fe10bfbd5571
NOTION_ANALYTICS_DB_ID=e20dae53-8585-4c59-b88c-a12d8461e6e3

# ========== 搜索服务配置 ==========
SERPAPI_KEY=your-serpapi-key-here

# ========== Manus API配置 (Nano Banana图片生成) ==========
MANUS_API_KEY=your-manus-api-key-here

# ========== 热点抓取配置 ==========
# 关键词列表（逗号分隔）
TREND_KEYWORDS=MBTI,人格测试,16型人格,MBTI性格,心理测试,职场MBTI,恋爱MBTI

# 抓取源（多源聚合）
# 支持：微博热搜、小红书热榜、知乎热榜、Google搜索、百度搜索
TREND_SOURCES=weibo,xiaohongshu,zhihu,google,baidu

# ========== 内容创作配置 ==========
# 目标平台（逗号分隔）
CONTENT_PLATFORMS=小红书,微信公众号

# 内容策略比例
STRATEGY_EDUCATIONAL=0.7
STRATEGY_EMOTIONAL=0.2
STRATEGY_PROMOTIONAL=0.1

# 图片生成
IMAGE_GENERATION_ENABLED=true
IMAGE_MODEL=nano-banana

# ========== 产品配置 ==========
BRAND_NAME=原野雾芽
BRAND_VOICE=不被定义，自己定义
PRODUCT_CATEGORY=茶饮

# ========== 发布配置 ==========
# 小红书
XIAOHONGSHU_ENABLED=true
XIAOHONGSHU_AUTO_PUBLISH=false  # 是否自动发布（需要API或RPA）

# 微信公众号
WECHAT_ENABLED=true
WECHAT_AUTO_PUBLISH=false

# 抖音
DOUYIN_ENABLED=false
DOUYIN_AUTO_PUBLISH=false

# 知乎
ZHIHU_ENABLED=false
ZHIHU_AUTO_PUBLISH=false

# ========== 监测配置 ==========
MONITORING_ENABLED=true
MONITORING_INTERVAL=6  # 监测间隔（小时）

# ========== 反爬虫配置 ==========
# 请求延迟（毫秒）
REQUEST_DELAY_MIN=100
REQUEST_DELAY_MAX=500

# 代理配置（可选）
# PROXY_ENABLED=false
# PROXY_URL=http://your-proxy-server:port

# ========== 通知配置 ==========
NOTIFICATION_EMAIL=your-email@example.com
NOTIFICATION_WEBHOOK=https://your-webhook-url.com

# ========== 调试配置 ==========
DEBUG_MODE=false
LOG_LEVEL=info
