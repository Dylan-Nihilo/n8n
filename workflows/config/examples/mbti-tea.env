# ==========================================
# MBTI茶饮营销自动化配置
# ==========================================

# ========== AI服务配置 ==========
AI_API_BASE_URL=https://api.openai.com
OPENAI_API_KEY=sk-your-openai-api-key-here
AI_MODEL=gpt-4o-mini

# ========== Notion配置 ==========
NOTION_API_TOKEN=secret_your-notion-integration-token-here
NOTION_HOTSPOT_DB_ID=your-hotspot-database-id
NOTION_MATERIAL_DB_ID=your-material-database-id
NOTION_PRODUCT_DB_ID=your-product-database-id
NOTION_CONTENT_DB_ID=your-content-database-id
NOTION_PUBLISH_DB_ID=your-publish-database-id
NOTION_ANALYTICS_DB_ID=your-analytics-database-id

# ========== 搜索服务配置 ==========
SERPAPI_KEY=your-serpapi-key-here

# ========== 热点抓取配置 ==========
# 关键词列表（逗号分隔）
TREND_KEYWORDS=MBTI,人格测试,16型人格,MBTI性格,心理测试

# ========== 内容创作配置 ==========
# 目标平台（逗号分隔）
CONTENT_PLATFORMS=小红书,微信公众号

# 内容策略比例
STRATEGY_EDUCATIONAL=0.7
STRATEGY_EMOTIONAL=0.2
STRATEGY_PROMOTIONAL=0.1

# ========== 产品配置 ==========
BRAND_NAME=原野雾芽
BRAND_VOICE=不被定义，自己定义
PRODUCT_CATEGORY=茶饮

# ========== 发布配置 ==========
# 小红书
XIAOHONGSHU_ENABLED=true
XIAOHONGSHU_AUTO_PUBLISH=false  # 是否自动发布（需要API）

# 微信公众号
WECHAT_ENABLED=true
WECHAT_AUTO_PUBLISH=false

# ========== 监测配置 ==========
MONITORING_ENABLED=true
MONITORING_INTERVAL=6  # 监测间隔（小时）

# ========== 通知配置 ==========
NOTIFICATION_EMAIL=your-email@example.com
NOTIFICATION_WEBHOOK=https://your-webhook-url.com
