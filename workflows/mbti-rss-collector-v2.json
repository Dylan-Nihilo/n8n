{
  "name": "MBTI素材采集器 v2",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * *"
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "每天9点执行",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        100
      ]
    },
    {
      "parameters": {},
      "id": "manual-trigger",
      "name": "手动触发",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://serpapi.com/search",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "MBTI 热议话题 2025"
            },
            {
              "name": "api_key",
              "value": "{{$env.SERPAPI_KEY}}"
            },
            {
              "name": "engine",
              "value": "google"
            },
            {
              "name": "gl",
              "value": "cn"
            },
            {
              "name": "hl",
              "value": "zh-cn"
            },
            {
              "name": "num",
              "value": "10"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "search-mbti",
      "name": "搜索MBTI话题",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        250,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "// 提取搜索结果\nconst results = $input.first().json.organic_results || [];\nconst items = [];\n\nfor (const result of results.slice(0, 5)) {\n  items.push({\n    json: {\n      title: result.title,\n      url: result.link,\n      snippet: result.snippet,\n      source: result.source || '搜索结果'\n    }\n  });\n}\n\nreturn items;"
      },
      "id": "extract-results",
      "name": "提取搜索结果",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        470,
        200
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$json.url}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"
            },
            {
              "name": "Accept-Language",
              "value": "zh-CN,zh;q=0.9"
            }
          ]
        },
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "fullResponse": true
            }
          }
        }
      },
      "id": "fetch-webpage",
      "name": "抓取网页内容",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        690,
        200
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "operation": "extractHtmlContent",
        "sourceData": "={{$json.body}}",
        "extractionValues": {
          "values": [
            {
              "key": "pageTitle",
              "cssSelector": "h1, title",
              "returnValue": "text"
            },
            {
              "key": "mainContent",
              "cssSelector": "article, .content, main, .post-content, p",
              "returnValue": "text"
            },
            {
              "key": "metaDescription",
              "cssSelector": "meta[name='description']",
              "returnValue": "attribute",
              "attribute": "content"
            }
          ]
        }
      },
      "id": "extract-html",
      "name": "提取HTML内容",
      "type": "n8n-nodes-base.html",
      "typeVersion": 1.1,
      "position": [
        910,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8045/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-sonnet-4-5-thinking\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"你是一个MBTI内容分析专家。请以JSON格式返回分析结果，不要包含其他内容。\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"分析以下内容，返回JSON：\\n\\n标题：{{ $('提取搜索结果').item.json.title }}\\n内容：{{ $json.mainContent }}\\n\\n返回格式：{\\\"摘要\\\":\\\"100字内\\\",\\\"创作角度\\\":\\\"角度1|角度2|角度3\\\",\\\"热度评分\\\":7.5,\\\"契合度评分\\\":8.0,\\\"话题分类\\\":[\\\"MBTI\\\",\\\"热点\\\"],\\\"MBTI相关\\\":[\\\"MBTI\\\"]}\"\n    }\n  ],\n  \"temperature\": 0.7,\n  \"max_tokens\": 1000\n}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "ai-analysis",
      "name": "AI内容分析",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1130,
        200
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "// 整合AI分析结果\nconst searchResult = $('提取搜索结果').item.json;\nconst htmlContent = $('提取HTML内容').item.json;\nconst aiResponse = $json;\n\n// 解析AI返回的JSON\nlet analysis;\ntry {\n  const content = aiResponse.choices?.[0]?.message?.content || '{}';\n  // 提取JSON部分\n  const jsonMatch = content.match(/\\{[\\s\\S]*\\}/);\n  analysis = jsonMatch ? JSON.parse(jsonMatch[0]) : {};\n} catch (e) {\n  analysis = {\n    摘要: htmlContent.metaDescription || searchResult.snippet || '无摘要',\n    创作角度: '社交话题 | 内容创作 | 用户互动',\n    热度评分: 7.0,\n    契合度评分: 6.5,\n    话题分类: ['MBTI', '其他'],\n    'MBTI相关': ['MBTI']\n  };\n}\n\n// 质量过滤\nif ((analysis.契合度评分 || 0) < 6.0) {\n  return [];\n}\n\nconst today = new Date().toISOString().split('T')[0];\n\nreturn [{\n  json: {\n    标题: htmlContent.pageTitle || searchResult.title,\n    原文链接: searchResult.url,\n    原文摘要: analysis.摘要 || searchResult.snippet,\n    创作角度: analysis.创作角度 || '',\n    热度评分: analysis.热度评分 || 7.0,\n    契合度: analysis.契合度评分 || 6.5,\n    来源: searchResult.source,\n    状态: '待评估',\n    话题分类: analysis.话题分类 || ['MBTI'],\n    'MBTI相关': analysis['MBTI相关'] || ['MBTI'],\n    采集时间: today,\n    content: (htmlContent.mainContent || '').substring(0, 2000)\n  }\n}];"
      },
      "id": "merge-data",
      "name": "整合数据",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1350,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "// 构建Notion请求体\nconst d = $json;\nconst body = {\n  parent: { database_id: '2d87fa67-a9af-81b9-9b07-cde5013942b4' },\n  properties: {\n    '标题': { title: [{ text: { content: d.标题 || '无标题' } }] },\n    '来源': { select: { name: d.来源 || '搜索' } },\n    '原文链接': { url: d.原文链接 || 'https://example.com' },\n    '原文摘要': { rich_text: [{ text: { content: (d.原文摘要 || '').substring(0, 500) } }] },\n    '热度评分': { number: d.热度评分 || 5 },\n    '契合度': { number: d.契合度 || 5 },\n    '创作角度': { rich_text: [{ text: { content: d.创作角度 || '' } }] },\n    '使用次数': { number: 0 },\n    '状态': { select: { name: d.状态 || '待评估' } }\n  }\n};\nreturn [{ json: { notionBody: JSON.stringify(body), originalData: d } }];"
      },
      "id": "build-notion-body",
      "name": "构建Notion请求",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1570,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.notion.com/v1/pages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{$env.NOTION_API_TOKEN}}"
            },
            {
              "name": "Notion-Version",
              "value": "2022-06-28"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.notionBody }}",
        "options": {}
      },
      "id": "write-notion",
      "name": "写入Notion",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1790,
        200
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "aggregate": "aggregateAllItemData"
      },
      "id": "aggregate-results",
      "name": "汇总结果",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [
        2010,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "// 生成执行摘要\nconst items = $input.first().json.data || [];\nconst successCount = items.filter(item => item.id || item.originalData).length;\nconst totalCount = items.length;\n\nconst summary = `MBTI素材采集报告 v2\n========================\n成功写入: ${successCount}/${totalCount} 条\n采集时间: ${new Date().toLocaleString('zh-CN')}\n\n升级说明:\n- 数据源: SerpAPI 主动搜索\n- 内容: 抓取原网页正文\n- 分析: AI分析(待配置)\n- 过滤: 契合度<6.0自动过滤`;\n\nreturn [{\n  json: {\n    report: summary,\n    successCount,\n    totalCount,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "generate-summary",
      "name": "生成摘要",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2230,
        200
      ]
    }
  ],
